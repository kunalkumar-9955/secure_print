<Window x:Class="SecurePrint.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecurePrint Desktop Agent" Height="620" Width="820"
        Background="{StaticResource DarkBg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SecurePrint Desktop Agent" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextLight}"/>
                    <TextBlock x:Name="TxtMachineInfo" Text="Machine: Windows Host | Installation ID: ..." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#14532d" CornerRadius="14" Padding="12,6">
                    <TextBlock x:Name="TxtStatus" Text="OFFLINE" FontWeight="Bold" Foreground="#4ade80" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Pairing Section -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtPairingTitle" Text="Connect this computer to a Print Shop" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextLight}"/>
                <TextBlock x:Name="TxtPairingHelp" Text="Open your Shop Console (Desktop Agents → Click 'Connect Computer') to generate a 6-digit code." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPairingCode" MaxLength="6" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" x:Name="BtnPair" Content="Connect to Shop" Width="150" Height="40" Background="{StaticResource PrimaryGreen}" Foreground="White" FontWeight="Bold" Click="BtnPair_Click" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Grid.Column="2" x:Name="TxtPairResult" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Printers and Activity Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Discovered Windows Printers -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Discovered Windows Printers" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextLight}"/>
                        <Button DockPanel.Dock="Right" Content="Refresh" Background="#334155" Foreground="White" Padding="10,4" BorderThickness="0" Click="BtnRefreshPrinters_Click" Cursor="Hand"/>
                    </DockPanel>
                    
                    <ListBox Grid.Row="1" x:Name="ListPrinters" Background="#0f172a" BorderBrush="#334155" Foreground="{StaticResource TextLight}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding WindowsPrinterName}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding DriverName}" FontSize="11" Foreground="#94a3b8"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="Bold" Foreground="#4ade80" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" x:Name="BtnTestPrint" Content="Execute Real Test Print" Background="#0284c7" Foreground="White" FontWeight="Bold" Height="36" Margin="0,10,0,0" BorderThickness="0" Click="BtnTestPrint_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Activity Logs -->
            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Agent Activity Log" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1" x:Name="TxtLogs" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0f172a" Foreground="#94a3b8" BorderBrush="#334155" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtFooter" Text="Ready - Connected to SecurePrint Cloud" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
