PORT=4000
NODE_ENV=production
API_BASE_URL=https://api.secureprint.example
PUBLIC_BASE_URL=https://secureprint.example

DATABASE_URL=postgresql://user:password@localhost:5432/secureprint?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-secure-32-character-secret
JWT_EXPIRES_IN=7d

STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_BUCKET=secureprint-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

TZ=Asia/Kolkata
