{
  "name": "secureprint-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build:packages && npm run build:web",
    "build:packages": "npm --workspace=packages/shared-types run build && npm --workspace=packages/config run build && npm --workspace=packages/validation run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "test:api": "npm --workspace=apps/api run test",
    "test:e2e": "npm --workspace=apps/api run test:e2e",
    "prisma:generate": "npm --workspace=apps/api run prisma:generate",
    "prisma:migrate": "npm --workspace=apps/api run prisma:migrate",
    "prisma:seed": "npm --workspace=apps/api run prisma:seed",
    "admin:bootstrap": "npm --workspace=apps/api run admin:bootstrap",
    "start:api": "npm --workspace=apps/api run start:prod"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3"
  }
}
